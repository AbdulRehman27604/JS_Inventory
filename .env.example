# Copy to .env.render.local (ignored by Git). Never commit actual connection strings.
# On Render, add these under the web service's Environment settings instead.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Use Render's Internal Database URL in its web service, External Database URL on your Mac.
# Generate once: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AUTH_ENCRYPTION_KEY=REPLACE_WITH_YOUR_64_CHARACTER_RANDOM_HEX_SECRET
# Optional initial cloud administrator: created only if the users table is empty.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_YOUR_OWN_PASSWORD
# Render supplies PORT and RENDER_EXTERNAL_HOSTNAME automatically.
# PUBLIC_HOST=inventory.example.com
# COOKIE_SECURE=1
